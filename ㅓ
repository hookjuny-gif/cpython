import random

# 1~100 사이의 숫자 중 컴퓨터가 하나 고름
secret = random.randint(1, 100)
tries = 0

print("🎯 숫자 맞추기 게임!")
print("1부터 100 사이의 숫자 중 하나를 맞춰보세요.")

while True:
    guess = input("당신의 추측은? ")
    
    if not guess.isdigit():
        print("숫자만 입력하세요!")
        continue
    
    guess = int(guess)
    tries += 1

    if guess < secret:
        print("⬆️ 더 큰 숫자입니다.")
    elif guess > secret:
        print("⬇️ 더 작은 숫자입니다.")
    else:
        print(f"🎉 정답입니다! {tries}번 만에 맞췄어요!")
        break
